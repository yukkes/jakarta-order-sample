<?xml version="1.0" encoding="UTF-8"?>
<server description="Jakarta EE order sample on Open Liberty">

    <!-- Only the features this application uses. `jakartaee-11.0` pulls in JSF, JSP, Mail,
         Connectors, Messaging and full EJB, which roughly doubles startup time. -->
    <featureManager>
        <feature>servlet-6.1</feature>
        <feature>restfulWS-4.0</feature>
        <feature>cdi-4.1</feature>
        <feature>persistence-3.2</feature>
        <feature>persistenceContainer-3.2</feature>
        <feature>jdbc-4.3</feature>
        <feature>jsonb-3.0</feature>
        <feature>jsonp-2.1</feature>
        <feature>validation-3.1</feature>
        <feature>batch-2.1</feature>
        <feature>enterpriseBeansLite-4.0</feature>
        <feature>appSecurity-6.0</feature>
        <feature>mpOpenAPI-4.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="8080"
                  httpsPort="9443"/>

    <!-- The application authenticates with its own tokens, so no container users are defined.
         A registry is still required for the ORB that the EJB container starts. -->
    <basicRegistry id="basic" realm="BasicRealm"/>

    <!-- The app calls JobOperator as an unauthenticated subject, so batch submission and
         monitoring must be open to EVERYONE. There is no batchAdmin: the sample has no
         user who manages other users' jobs. -->
    <authorization-roles id="com.ibm.ws.batch">
        <security-role name="batchSubmitter">
            <special-subject type="EVERYONE"/>
        </security-role>
        <security-role name="batchMonitor">
            <special-subject type="EVERYONE"/>
        </security-role>
    </authorization-roles>

    <!-- Core persistence.xml has no jta-data-source, so point the container at this datasource. -->
    <jpa defaultJtaDataSourceJndiName="jdbc/orderDB"/>

    <library id="postgresLib">
        <fileset dir="${server.config.dir}/lib" includes="postgresql-*.jar"/>
    </library>

    <!-- Database credentials. Override them with the DB_USER / DB_PASSWORD / DB_URL
         environment variables (or server.env); the defaults are for local development only. -->
    <variable name="DB_USER" defaultValue="orders"/>
    <variable name="DB_PASSWORD" defaultValue="orders"/>
    <variable name="DB_URL" defaultValue="jdbc:postgresql://localhost:5432/orders"/>

    <jdbcDriver id="postgresDriver" libraryRef="postgresLib"/>

    <dataSource id="orderDataSource" jndiName="jdbc/orderDB" jdbcDriverRef="postgresDriver" statementCacheSize="100">
        <properties URL="${DB_URL}"
                    user="${DB_USER}"
                    password="${DB_PASSWORD}"/>
        <!-- The default pool (50) becomes the throughput ceiling under concurrency. -->
        <connectionManager maxPoolSize="100" minPoolSize="10"/>
    </dataSource>

    <application location="order-sample.war"/>

    <logging traceSpecification="com.example.order.*=info"/>
</server>
